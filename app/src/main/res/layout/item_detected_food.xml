<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_detected_food_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Linha com nome do alimento e confiança -->
    <LinearLayout
        android:id="@+id/row_title_confidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtFoodName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alimento"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="95%"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Linha com valor em gramas e kcal estimado -->
    <LinearLayout
        android:id="@+id/row_values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/txtGramsValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="150 g"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtKcalEstimate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≈ 210 kcal"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Slider para ajustar gramas -->
    <SeekBar
        android:id="@+id/seekGrams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progress="150" />

    <!-- Observação opcional (ex.: dica de porção) -->
    <TextView
        android:id="@+id/txtHintPortion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <!-- Divisor simples -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#1F000000" />

</LinearLayout>
