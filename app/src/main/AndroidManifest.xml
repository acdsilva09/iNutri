<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.inutri">

    <!-- Permissões essenciais -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Marca câmera como opcional para permitir instalação em devices sem câmera -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.INutri">

        <!-- FileProvider para compartilhar arquivos de imagem (CameraX) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.inutri.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.INutri">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity
            android:name=".LoginActivity"
            android:exported="true" />
        <activity
            android:name=".CadastroActivity"
            android:exported="true"
            android:theme="@style/Theme.INutri.Fullscreen" />
        <activity
            android:name=".RecuperaCadastroActivity"
            android:exported="false" />

        <!-- Host da navegação -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.INutri.NoActionBar" />

        <!-- Nova tela de captura de refeição -->
        <activity
            android:name=".CaptureMealActivity"
            android:exported="false"
            android:theme="@style/Theme.INutri.Fullscreen" />

    </application>
</manifest>
