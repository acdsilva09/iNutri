<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.inutri">

    <!-- Permissões essenciais -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Câmera opcional para permitir instalação em devices sem câmera -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.INutri">

        <!-- FileProvider p/ compartilhar o arquivo da foto dentro do app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.inutri.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Launcher / Splash -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.INutri">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true" />
        <activity
            android:name=".ui.auth.CadastroActivity"
            android:exported="true"
            android:theme="@style/Theme.INutri.Fullscreen" />
        <activity
            android:name=".ui.auth.RecuperaCadastroActivity"
            android:exported="false" />

        <!-- Host principal -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.INutri.NoActionBar" />

        <!-- Captura com CameraX -->
        <activity
            android:name=".ui.capture.CaptureMealActivity"
            android:exported="false"
            android:theme="@style/Theme.INutri.Fullscreen" />

        <!-- Resultado da detecção (MOSTRE os itens detectados) -->
        <activity
            android:name=".ui.detection.DetectionResultActivity"
            android:exported="false"
            android:label="@string/title_detection_result"
            android:parentActivityName=".ui.capture.CaptureMealActivity" />

        <!-- Resumo nutricional (após o usuário ajustar as quantidades) -->
        <activity
            android:name=".data.nutrition.NutritionSummaryActivity"
            android:exported="false"
            android:label="@string/title_nutrition_summary"
            android:parentActivityName=".ui.detection.DetectionResultActivity" />

    </application>
</manifest>
